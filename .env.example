# ================= EventOps Backend - Environment =================
# Copy this file to ".env" and fill in your own values.
# All values MUST be present on your hosting platform (Render/Railway/...).

# MongoDB connection string (use MongoDB Atlas in production)
MONGO_URI=mongodb://127.0.0.1:27017/eventops

# Port (hosting platforms usually set this automatically - leave the default)
PORT=3000

# Public URL of THIS backend, used to build the email-verification link.
# Example: https://eventops-api.onrender.com   (no trailing slash)
BASE_URL=http://localhost:3000

# Public URL of the FRONTEND, where users are redirected after verifying email.
# Example: https://eventops-front.netlify.app   (no trailing slash)
FRONTEND_URL=http://localhost:5500

# JWT signing secret - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# SMTP email settings (Gmail example - use an App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
